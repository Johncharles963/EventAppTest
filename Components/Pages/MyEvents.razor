@page "/my-events"
@using CourseraEventApp.Data
@using CourseraEventApp.Services
@inject AttendeeSessionState SessionState
@inject AttendanceTracker AttendanceTracker

<PageTitle>My events | EventEase</PageTitle>

<section class="event-detail-page">
    <div class="events-list__heading">
        <div>
            <p class="eyebrow">Your EventEase session</p>
            <h1>My events</h1>
        </div>
        <span>@_registeredEvents.Count @(_registeredEvents.Count == 1 ? "registration" : "registrations")</span>
    </div>

    @if (_registeredEvents.Count == 0)
    {
        <article class="event-detail">
            <h2>No events saved yet</h2>
            <p class="event-detail__description">
                Your registrations will appear here while this EventEase session is active.
            </p>
            <NavLink class="button-link" href="/events">Browse events</NavLink>
        </article>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(SessionState.FullName))
        {
            <p class="session-greeting">Welcome back, @SessionState.FullName.</p>
        }

        <div class="event-grid">
            @foreach (var eventItem in _registeredEvents)
            {
                <article class="event-card" @key="eventItem.Id">
                    <div class="event-card__accent" aria-hidden="true"></div>
                    <div class="event-card__content">
                        <span class="event-card__category">Registered</span>
                        <h2>@eventItem.Name</h2>
                        <p class="event-card__date">@eventItem.Date.ToString("MMMM d, yyyy")</p>
                        <p class="event-card__location">@eventItem.Location</p>
                        <p class="attendance-count">@AttendanceTracker.GetAttendanceCount(eventItem.Id) attendees</p>
                        <NavLink class="event-card__link" href="@($"/events/{eventItem.Id}")">View event</NavLink>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<CourseraEventApp.Models.Event> _registeredEvents = [];

    protected override void OnParametersSet()
    {
        _registeredEvents = SessionState.RegisteredEventIds
            .Select(EventCatalog.FindById)
            .OfType<CourseraEventApp.Models.Event>()
            .ToArray();
    }
}
