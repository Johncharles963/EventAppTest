@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | EventEase</PageTitle>

<section class="event-detail-page">
    <article class="event-detail">
        <p class="eyebrow">404 · Page not found</p>
        <h1>That page isn’t on the calendar.</h1>
        <p class="event-detail__description">
            The address may be outdated or incorrect. Browse the upcoming events to find your way back.
        </p>
        <NavLink class="button-link" href="/events">Explore all events</NavLink>
    </article>
</section>